stateDiagram-v2
    %% Styling
    classDef interactive fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
    classDef processing fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
    classDef passive fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px;

    [*] --> Idle

    state Idle {
        [*] --> BrowsingDashboard
    }

    Idle --> QueryDrafting : User types input
    
    state QueryDrafting {
        [*] --> Typing
        Typing --> AutoComplete : /suggestTopics
    }

    QueryDrafting --> ProcessingQuery : Submit

    state ProcessingQuery {
        [*] --> IntentClassification
        
        %% Simplified State Name
        state RAG_Process {
            [*] --> VectorSearch
            VectorSearch --> ContextAssembly
        }
        
        IntentClassification --> RAG_Process : Topic Detected
        RAG_Process --> LLMGeneration : Context Ready
    }

    ProcessingQuery --> InsightPresentation : Success

    state InsightPresentation {
        [*] --> DisplayText
        DisplayText --> RenderCharts : Data Available
        DisplayText --> ShowSources
    }

    %% The Learning Loop
    InsightPresentation --> DeepDive : Click Source
    InsightPresentation --> Refinement : Follow-up Question
    InsightPresentation --> Idle : Session End

    state Refinement {
        [*] --> AdjustContext
        AdjustContext --> ProcessingQuery : Re-submit
    }

    state DeepDive {
        [*] --> LoadRawData
        LoadRawData --> DisplayFullReport
    }

    DeepDive --> InsightPresentation : Back

    %% Apply Classes
    class Idle,QueryDrafting,DeepDive passive
    class InsightPresentation,Refinement interactive
    class ProcessingQuery processing